{
  "name": "@poesygen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@poesygen/contracts": "workspace:*",
    "@poesygen/domain": "workspace:*",
    "@poesygen/patterns": "workspace:*",
    "@poesygen/prosody": "workspace:*",
    "@poesygen/queue": "workspace:*",
    "fastify": "^5.11.2"
  },
  "devDependencies": {
    "tsx": "^4.23.5"
  }
}
