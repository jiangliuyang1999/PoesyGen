{
  "name": "@poesygen/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capacitor mobile shell for the shared PoesyGen web client",
  "scripts": {
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "package:android:aab": "bash scripts/package-android.sh release-aab",
    "package:android:apk": "bash scripts/package-android.sh release-apk",
    "package:android:test": "bash scripts/package-android.sh debug-apk",
    "package:ios:adhoc": "bash scripts/package-ios.sh adhoc",
    "package:ios:simulator": "bash scripts/package-ios-simulator.sh",
    "package:ios:testflight": "bash scripts/package-ios.sh testflight",
    "run:android": "pnpm run sync && cap run android",
    "run:ios": "pnpm run sync && cap run ios",
    "sync": "pnpm --filter @poesygen/web build && cap sync",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@poesygen/web": "workspace:*",
    "typescript": "^7.0.2"
  }
}
