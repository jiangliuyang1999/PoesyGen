HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://poesygen:poesygen@localhost:5432/poesygen
REDIS_URL=redis://localhost:6379

# OpenAI-compatible provider. OpenAI:
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_JSON_MODE=true
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=4096
WORKER_CONCURRENCY=1

# Volcengine Ark example:
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=<endpoint-id>
# LLM_API_KEY=<ARK_API_KEY>

# Deterministic local end-to-end verification only:
# LLM_PROVIDER=mock
