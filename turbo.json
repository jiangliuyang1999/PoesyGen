{
  "$schema": "https://v2-10-9.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "LLM_BASE_URL",
        "LLM_ENDPOINT",
        "LLM_MODEL",
        "LLM_API_KEY",
        "LLM_JSON_MODE",
        "LLM_TIMEOUT_MS",
        "LLM_MAX_TOKENS",
        "LLM_EXTRA_HEADERS"
      ]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
